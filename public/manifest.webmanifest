{
  "name": "Sedona Soul Companion",
  "short_name": "Sedona Soul",
  "description": "Sedona Soul recovery and repair companion PWA.",
  "start_url": "/app/home",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#F4EFE6",
  "theme_color": "#12362C",
  "orientation": "portrait-primary",
  "categories": ["health", "lifestyle", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Daily check-in",
      "short_name": "Check-in",
      "description": "Start today's Sedona Soul check-in.",
      "url": "/app/today",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    {
      "name": "Guide chat",
      "short_name": "Guide",
      "description": "Open your workbook-trained guide.",
      "url": "/app/guide",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
}
